# Copy to .env for local development. Never commit .env.

# --- Database -------------------------------------------------------------
# The port `npm run db:start` (and docker compose) serves PostgreSQL on. Change it here and in the
# three URLs below together.
FORGE_DB_PORT=54329
# Same URL whether Postgres comes from `npm run db:start` or docker compose.
DATABASE_URL=postgres://forge:forge@localhost:54329/forge
# Integration tests run against this database and may drop its tables.
TEST_DATABASE_URL=postgres://forge:forge@localhost:54329/forge_test
# End-to-end browser tests get their own database so they never touch development data.
E2E_DATABASE_URL=postgres://forge:forge@localhost:54329/forge_e2e

# --- API ------------------------------------------------------------------
API_HOST=127.0.0.1
# Changing it? Change API_INTERNAL_URL below to match.
API_PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Sign-in --------------------------------------------------------------
# Development-only account switcher with seeded test users (see docs/development-accounts.md).
# The API refuses to start with this on when NODE_ENV=production.
FORGE_DEV_AUTH=1
# Lets "Reset demo data" in the account menu wipe every table and reseed. Off by default: it
# deletes everything in DATABASE_URL and signs everyone out. `npm run db:reseed` works regardless.
FORGE_DEV_RESET=0
# Origins allowed to make writes with a session cookie (comma-separated, no paths).
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# How long a sign-in lasts, in hours (1 to 720).
SESSION_TTL_HOURS=168
# Only behind a reverse proxy that writes X-Forwarded-For itself (nginx, Caddy): 'loopback' or its
# addresses. Left unset, the address is the connection's own and a claimed header is ignored.
# TRUST_PROXY=loopback

# --- Web ------------------------------------------------------------------
# The port the web app serves on. Changing it? Change WEB_ORIGIN above to match.
WEB_PORT=3000
# Where the web server reaches the API (server-side only).
API_INTERNAL_URL=http://127.0.0.1:4000
