# Copy to .env for local development. Never commit .env.

# --- Database -------------------------------------------------------------
# Same URL whether Postgres comes from `npm run db:start` or docker compose.
DATABASE_URL=postgres://forge:forge@localhost:54329/forge
# Integration tests run against this database and may drop its tables.
TEST_DATABASE_URL=postgres://forge:forge@localhost:54329/forge_test
# End-to-end browser tests get their own database so they never touch development data.
E2E_DATABASE_URL=postgres://forge:forge@localhost:54329/forge_e2e

# --- API ------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Sign-in --------------------------------------------------------------
# Development-only account switcher with seeded test users (see docs/development-accounts.md).
# The API refuses to start with this on when NODE_ENV=production.
FORGE_DEV_AUTH=1
# Origins allowed to make writes with a session cookie (comma-separated, no paths).
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# How long a sign-in lasts, in hours (1 to 720).
SESSION_TTL_HOURS=168

# --- Web ------------------------------------------------------------------
# Where the web server reaches the API (server-side only).
API_INTERNAL_URL=http://127.0.0.1:4000
